# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/chatly

# Redis Configuration (for socket scaling)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Configuration
JWT_SECRET=replace_with_a_secure_long_random_string_at_least_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_another_secure_long_random_string_at_least_32_chars
JWT_REFRESH_EXPIRATION=7d

# Encryption Configuration (AES-256-GCM)
# Must be a 32-byte hex string (64 characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS & Security Configuration
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,https://chatapp.nikesh-sahoo.workers.dev
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100
